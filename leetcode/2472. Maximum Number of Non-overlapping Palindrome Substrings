class Solution:
    def maxPalindromes(self, S: str, k: int) -> int:
        n, i, res = len(S), 0, 0
        while i <= n - k:
            for l in [k, k + 1]:
                if i + l <= n and S[i:i+l] == S[i:i+l][::-1]:
                    res += 1
                    i += (l - 1)
                    break
            i += 1
        return res
