# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def addTwoNumbers(self, l1: Optional[ListNode], l2: Optional[ListNode]) -> Optional[ListNode]:
        dummy=ListNode(-1)
        curr=dummy
        carry=0
        while l1!=None or l2!=None or carry!=0:
            if l1!=None:
                a=l1.val
            else:
                a=0
            if l2!=None:
                b=l2.val
            else:
                b= 0
            total=a+b+carry
            digit=total%10
            carry=total//10
            curr.next=ListNode(digit)
            curr=curr.next
            if l1!=None:
                l1=l1.next
            if l2!=None:
                l2=l2.next
        
        return dummy.next
        
        



        
