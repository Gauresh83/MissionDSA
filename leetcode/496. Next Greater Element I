class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        stack=[]
        set1={}
        for num in reversed(nums2):
            while stack and stack[-1]<=num:
                stack.pop()
            if stack:
                set1[num]=stack[-1]

            else:
                set1[num]=-1


            
            stack.append(num)
        ans=[]
        for i in nums1:
            ans.append(set1[i])
        return ans
        
        
